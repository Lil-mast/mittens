# Frontend API address. Must be available to the browser.
REACT_APP_API_URL=http://localhost:5000/api

# App addresses and runtime
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# MariaDB. URL-encode special characters in the username or password.
DATABASE_URL=mysql://mittens:change-me@localhost:3306/mittens

# Use a unique, random value in every environment (for example: openssl rand -base64 32).
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth client; redirect URI must match the one registered in Google Cloud.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Agent Router credentials and model. The sample model must be enabled for your key.
AGENTROUTER_API_KEY=your-agentrouter-api-key
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.5

# SMTP is needed for forgot-password emails.
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM="Mittens <no-reply@example.com>"
